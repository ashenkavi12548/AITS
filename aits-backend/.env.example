NODE_ENV=development
PORT=5001

# Database Connection String
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/aits?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-aits-jwt-token-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Google Cloud Storage (for Document Management)
GOOGLE_CLOUD_PROJECT_ID="aits-gcp-project-id"
GOOGLE_CLOUD_STORAGE_BUCKET="aits-document-bucket"

# Firebase Cloud Messaging (for Push Notifications)
FIREBASE_PROJECT_ID="aits-firebase-project-id"

# Nodemailer / SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AITS Sri Lanka <noreply@aits.gov.lk>"
FRONTEND_URL="http://localhost:3000"

# Super Admin Account (Hardcoded in environment)
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Administrator"
ADMIN_EMAIL="admin@aits.gov.lk"
ADMIN_PASSWORD="AdminSecurePassword2026!"
ADMIN_PHONE="+94112345678"

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME="s6cesrad"
CLOUDINARY_API_KEY="<YOUR_CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_CLOUDINARY_API_SECRET>"
